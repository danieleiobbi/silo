{
  "name": "silo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "auth:hash-password": "node --import tsx apps/server/src/auth/hash-password.ts",
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm start -w apps/server",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:up": "node --import tsx tests/environment.ts up",
    "test:stop": "node --import tsx tests/environment.ts stop",
    "test:integration": "node --import tsx tests/environment.ts verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "type": "module"
}
