{
  "name": "silo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "auth:hash-password": "node --import tsx apps/server/src/auth/hash-password.ts",
    "dev:web": "npm run dev -w apps/web --",
    "dev:server": "node --env-file=.env.development --import tsx --watch apps/server/src/index.ts",
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces && tsc -p scripts/tsconfig.json && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm start -w apps/server",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx scripts/environment.ts integration verify",
    "docker:build": "node --import tsx scripts/docker.ts build",
    "docker:up": "node --import tsx scripts/docker.ts up",
    "deploy": "node --import tsx scripts/docker.ts deploy",
    "dev:up": "node --import tsx scripts/environment.ts development up",
    "dev:stop": "node --import tsx scripts/environment.ts development stop"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "type": "module",
  "version": "0.0.0"
}
